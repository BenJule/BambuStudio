FROM debian:trixie@sha256:4ae67669760b807c19f23902a3fd7c121a6a70cf2ae709035674b23e712e4d62

LABEL org.opencontainers.image.source="https://github.com/BenJule/BambuStudio"
LABEL org.opencontainers.image.description="Debian trixie build environment for BambuStudio CI"
LABEL org.opencontainers.image.licenses="AGPL-3.0"

RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        sudo git curl git-lfs ca-certificates && \
    rm -rf /var/lib/apt/lists/*
